rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    // Super admin: verified email only (prevents unverified email/password impersonation)
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'hondastore299@gmail.com';
    }
    function isAdmin() {
      return isSuperAdmin()
        || (signedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'free') == 'admin');
    }
    function protectedKeys() {
      return ['role', 'isSuperAdmin', 'permissionsOverride', 'roleUpdatedAt', 'roleUpdatedBy',
              'disabled', 'disabledReason', 'disabledAt', 'disabledBy'];
    }
    // حساب موقوف من الإدارة
    function isDisabled(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('disabled', false) == true;
    }
    // ---------- فريق العمل (برو) ----------
    // صاحب الحساب لازم يكون برو (أو أدمن) وغير موقوف
    function ownerIsPro(ownerId) {
      return exists(/databases/$(database)/documents/users/$(ownerId))
        && get(/databases/$(database)/documents/users/$(ownerId)).data.get('role', 'free') in ['pro', 'admin']
        && get(/databases/$(database)/documents/users/$(ownerId)).data.get('disabled', false) != true;
    }
    function isTeamMember(ownerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.get('active', false) == true
        && ownerIsPro(ownerId);
    }
    function mperm(ownerId, key) {
      return isTeamMember(ownerId)
        && get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.perms.get(key, false) == true;
    }
    function memberCanCreateTx(ownerId, d) {
      return (d.type == 'income' && mperm(ownerId, 'addIncome'))
          || ((d.type == 'expense' || d.type == 'charity') && mperm(ownerId, 'addExpense'))
          || ((d.type == 'debt_receivable' || d.type == 'debt_payable') && mperm(ownerId, 'debts'));
    }
    function memberCanUpdateTx(ownerId, d) {
      return (mperm(ownerId, 'editTx')
              || ((d.type == 'debt_receivable' || d.type == 'debt_payable') && mperm(ownerId, 'debts')))
          && (d.get('_deleted', false) != true || mperm(ownerId, 'deleteTx'));
    }
    // العضو يكتب في مستند صاحب الحساب حقول محددة فقط، والمكن/المخزن بصلاحية
    function memberCanWriteUserDoc(ownerId) {
      return isTeamMember(ownerId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['updatedAt', 'txCount', 'appVersion', 'chargeMachines', 'inventory', 'clientPhones'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['chargeMachines']) || mperm(ownerId, 'machines'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['inventory']) || mperm(ownerId, 'inventory'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientPhones']) || mperm(ownerId, 'clients') || mperm(ownerId, 'debts'))
        && request.resource.data.get('clientPhones', {}).size() <= 500;
    }
    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    // الحقول الاختيارية في طلب العميل: لو موجودة لازم تكون بالنوع والحجم الصح
    function optStr(d, key, maxLen) {
      return !(key in d) || isStr(d[key], maxLen);
    }
    function validClientRequest(userId, reqId, d) {
      return d.keys().hasOnly(
               ['id','portalId','client','type','amount','category','notes','date','time',
                'paymentMethod','status','createdAt'])
          && d.keys().hasAll(['id','portalId','client','type','amount','notes'])
          && d.id == reqId
          && d.status == 'pending_approval'
          && d.type in ['income', 'debt_receivable', 'expense']
          && d.amount is number
          && d.amount > 0
          && d.amount < 100000000
          && isStr(d.client, 100)
          && isStr(d.notes, 300)
          && isStr(d.portalId, 64)
          && optStr(d, 'category', 60)
          && optStr(d, 'date', 20)
          && optStr(d, 'time', 20)
          && optStr(d, 'paymentMethod', 60)
          && (!('createdAt' in d) || d.createdAt is number)
          && exists(/databases/$(database)/documents/client_portals/$(d.portalId))
          && get(/databases/$(database)/documents/client_portals/$(d.portalId)).data.ownerUid == userId;
    }

    // ---------- Roles & global config ----------
    match /config/roles {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- ملاحظات المدير وسجل الإجراءات (للمديرين فقط) ----------
    match /admin_notes/{uid} {
      allow read, write: if isAdmin();
    }
    match /admin_audit/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- دعوات الفريق ----------
    // المستند id = ownerUid + '_' + email (بحروف صغيرة)
    match /team_invites/{inviteId} {
      allow get, list: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.email == request.auth.token.email && request.auth.token.email_verified == true)
      );
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && ownerIsPro(request.auth.uid)
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && inviteId == request.auth.uid + '_' + request.resource.data.email
        && request.resource.data.status == 'pending'
        && request.resource.data.perms is map;
      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.email == resource.data.email)
        || (resource.data.email == request.auth.token.email
          && request.auth.token.email_verified == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'memberUid', 'acceptedAt']))
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Server-side transaction shape validation (team members and tampered clients).
    function validTransaction(userId, txId, d) {
      return d.id == txId
          && d.type in ['income','expense','charity','debt_receivable','debt_payable']
          && d.amount is number && d.amount > 0 && d.amount <= 1000000000
          && isStr(d.date, 10) && d.date.matches('^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$')
          && (!('paidAmount' in d) || d.paidAmount is number)
          && optStr(d, 'time', 20)
          && optStr(d, 'client', 100)
          && optStr(d, 'category', 100)
          && optStr(d, 'paymentMethod', 50)
          && optStr(d, 'reference', 50)
          && optStr(d, 'notes', 200)
          && (!('dueDate' in d) || d.dueDate == null
              || (isStr(d.dueDate, 10) && d.dueDate.matches('^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$')))
          && (!('status' in d) || d.status == null || d.status in ['paid','pending'])
          && (!('_deleted' in d) || d._deleted is bool)
          && (!('_updatedAt' in d) || d._updatedAt is number)
          && (!('receipt' in d) || d.receipt == null
              || (isStr(d.receipt, 800) && d.receipt.matches('^https://')));
    }

      // ---------- Users ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isTeamMember(userId);

      // New accounts can only start as 'free' (no self-granted admin / overrides)
      allow create: if isSuperAdmin() || (
        isOwner(userId)
        && request.resource.data.get('role', 'free') == 'free'
        && request.resource.data.get('isSuperAdmin', false) == false
        && !('permissionsOverride' in request.resource.data)
        && !('disabled' in request.resource.data)
      );

      allow update: if isAdmin() || memberCanWriteUserDoc(userId) || (
        isOwner(userId)
        && !isDisabled(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys())
      );

      allow delete: if isSuperAdmin();

      // Private subcollections (explicit on purpose: a recursive wildcard here would
      // also match the user document itself and bypass the protected-keys rule above)
      match /transactions/{txId} {
        allow read: if isSuperAdmin() || (isOwner(userId) && !isDisabled(userId)) || isTeamMember(userId);
        allow create: if isSuperAdmin()
                      || (((isOwner(userId) && !isDisabled(userId)) || memberCanCreateTx(userId, request.resource.data))
                      && validTransaction(userId, txId, request.resource.data));
        allow update: if isSuperAdmin()
                      || (((isOwner(userId) && !isDisabled(userId)) || memberCanUpdateTx(userId, request.resource.data))
                      && validTransaction(userId, txId, request.resource.data));
        allow delete: if isSuperAdmin() || (isOwner(userId) && !isDisabled(userId)) || mperm(userId, 'deleteTx');
      }

      // أعضاء الفريق (يديرها صاحب الحساب؛ العضو بينشئ مستنده بس من خلال دعوة صحيحة)
      match /members/{memberId} {
        allow read: if isOwner(userId) || request.auth.uid == memberId || isAdmin();
        allow create: if isSuperAdmin() || (signedIn()
          && request.auth.uid == memberId
          && request.auth.token.email_verified == true
          && ownerIsPro(userId)
          && exists(/databases/$(database)/documents/team_invites/$(userId + '_' + request.auth.token.email))
          && get(/databases/$(database)/documents/team_invites/$(userId + '_' + request.auth.token.email)).data.status == 'pending'
          && get(/databases/$(database)/documents/team_invites/$(userId + '_' + request.auth.token.email)).data.ownerUid == userId
          && request.resource.data.perms == get(/databases/$(database)/documents/team_invites/$(userId + '_' + request.auth.token.email)).data.perms
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.active == true);
        allow update: if isOwner(userId) || isSuperAdmin();
        allow delete: if isOwner(userId) || request.auth.uid == memberId || isSuperAdmin();
      }
      // مؤشرات عضويتي في فرق تانية (الحقيقة دايماً من مستند members عند صاحب الفريق)
      match /memberships/{ownerId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }
      match /portal_index/{hashId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }

      // قفل التطبيق (PIN) المتزامن بين الأجهزة: يخزّن hash مملّح فقط (PBKDF2) وليس الرمز نفسه
      match /security/lock {
        allow read, delete: if isOwner(userId) || isSuperAdmin();
        allow create, update: if isSuperAdmin() || (isOwner(userId)
          && request.resource.data.keys().hasOnly(['v','salt','hash','iter','updatedAt'])
          && request.resource.data.keys().hasAll(['v','salt','hash','iter'])
          && request.resource.data.v == 3
          && isStr(request.resource.data.salt, 64)
          && isStr(request.resource.data.hash, 128)
          && request.resource.data.iter is int
          && request.resource.data.iter >= 100000
          && request.resource.data.iter <= 2000000
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number));
      }

      // Client requests submitted from a public portal link.
      // The portalId acts as an unguessable capability and must belong to this user.
      match /requests/{reqId} {
        allow create: if isSuperAdmin() || isOwner(userId)
                      || validClientRequest(userId, reqId, request.resource.data);
        allow read, update, delete: if isOwner(userId) || isSuperAdmin();
      }
    }

    // ---------- Client portals (public read-by-link, owner-managed) ----------
    match /client_portals/{portalId} {
      // 'get' needs the unguessable id; 'list' is blocked so portals can't be enumerated
      allow get: if true;
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() || (signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && isStr(request.resource.data.clientName, 100));
      allow update: if isSuperAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isSuperAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
  }
}
